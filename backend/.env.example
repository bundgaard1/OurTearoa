PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=ourtearoa
DB_PASSWORD=ourtearoa_dev
DB_NAME=ourtearoa

# LOCAL DEVELOPMENT (default): no SSL, matches docker compose at repo root.
# Start the DB with `npm run db:up`, then run `npm run db:migrate`.
DATABASE_URL="postgresql://ourtearoa:ourtearoa_dev@localhost:5432/ourtearoa?schema=public"

# AWS RDS (alternative): remember to URL-encode special characters (e.g. '#' -> %23)
# and point sslrootcert at your downloaded global-bundle.pem CA bundle.
# Requires your IP to be whitelisted in the RDS security group.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=verify-full&sslrootcert=../global-bundle.pem&schema=public"

