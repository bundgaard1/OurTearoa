direction: right


**.style.font-size: 30
(** -> **)[*].style.font-size: 30
(** -> **)[*].style.font-color: black


# Entity: users
users: {
  shape: sql_table
  id: "String [ UUID]" {constraint: primary_key}
  email: "String [UQ]"
  password: "String"
  name: "VarChar(100)"
  created_at: "DateTime"
  updated_at: "DateTime"
}

# Entity: places
places: {
  shape: sql_table
  id: "String [UUID]"{constraint: primary_key}
  name: "VarChar(200)"
  region: "VarChar(100)"
  description: "String?"
  latitude: "Float?"
  longitude: "Float?"
  type: "String?"
  image_url: "String?"
  created_at: "DateTime"
  updated_at: "DateTime"
}

# Entity: reviews
reviews: {
  shape: sql_table
  id: "String [UUID]" {constraint: primary_key}
  place_id: "String" {constraint: foreign_key}
  user_id: "String" {constraint: foreign_key}
  rating: "SmallInt"
  comment: "String?"
  created_at: "DateTime"
  updated_at: "DateTime"
}

# Entity: favorites
favorites: {
  shape: sql_table
  id: "String [UUID]" {constraint: primary_key}
  place_id: "String" {constraint: foreign_key}
  user_id: "String" {constraint: foreign_key}
  created_at: "DateTime"
}

# Entity: itinerary_entries
itinerary_entries: {
  shape: sql_table
  id: "String [UUID]" {constraint: primary_key}
  place_id: "String" {constraint: foreign_key}
  user_id: "String" {constraint: foreign_key}
  start_date: "DateTime"
  end_date: "DateTime"
  note: "String?"
  created_at: "DateTime"
  updated_at: "DateTime"
}

# Relationships (with onDelete: Cascade notation)
users -> reviews: "1 : N (Cascade)" {
  source-arrowhead: 1
  target-arrowhead: *
}
places -> reviews: "1 : N (Cascade)" {
  source-arrowhead: 1
  target-arrowhead: *
}

users -> favorites: "1 : N (Cascade)" {
  source-arrowhead: 1
  target-arrowhead: *
}
places -> favorites: "1 : N (Cascade)" {
  source-arrowhead: 1
  target-arrowhead: *
}

users -> itinerary_entries: "1 : N (Cascade)" {
  source-arrowhead: 1
  target-arrowhead: *
}
places -> itinerary_entries: "1 : N (Cascade)" {
  source-arrowhead: 1
  target-arrowhead: *
}