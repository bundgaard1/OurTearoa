direction: down

client: Client Tier (User Browser) {
  shape: person
  label: "User Browser / Angular 22 SPA\n(https://ourtearoa.duckdns.org)"
}

aws: AWS Cloud (ap-southeast-2) {
  style.stroke-dash: 3

  ec2: AWS EC2 (t3.micro - Amazon Linux 2023) {
    nginx: Nginx Reverse Proxy & TLS {
      shape: hexagon
      label: "Nginx (Port 443)\nTLS Termination (Let's Encrypt)"
    }

    static_spa: Static Web Root {
      shape: document
      label: "Static SPA Assets\n(/var/www/ourtearoa/)"
    }

    express_api: Application Tier {
      shape: rectangle
      label: "Node.js 26 / Express 5 API\n127.0.0.1:3000 (PM2 & tsx)\nPrisma 7 ORM"
    }

    nginx -> static_spa: "Serve /*"
    nginx -> express_api: "Proxy /api/*\n(HTTP 127.0.0.1:3000)"
  }

  data_tier: Data & Object Storage Tier {
    rds: AWS RDS PostgreSQL 16 {
      shape: cylinder
      label: "AWS RDS PostgreSQL 16\nPort 5432\nPrivate Security Group\n(sslmode=verify-full)"
    }

    s3: AWS S3 Bucket {
      shape: cylinder
      label: "AWS S3: ourtearoa-storage\nMedia Assets & Photos\n(/public/*)"
    }
  }
}

# Network & Application Connections
client -> aws.ec2.nginx: "1. HTTPS (Port 443)\nourtearoa.duckdns.org"
aws.ec2.express_api -> aws.data_tier.rds: "2. SQL Query over TLS\n(Port 5432)"
aws.ec2.express_api -> aws.data_tier.s3: "3. Media Metadata\nIAM Role via IMDS"
client -> aws.data_tier.s3: "Direct GET Media\n/public/*" {
  style.stroke-dash: 4
}