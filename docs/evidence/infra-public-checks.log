## 6. No mixed content: API base URL and absolute http:// URLs in the served bundles
$ curl -s https://ourtearoa.duckdns.org/ | grep -oE '[a-zA-Z0-9_-]+\.js' | sort -u
main-732ECDFW.js

$ for f in $(curl -s https://ourtearoa.duckdns.org/ | grep -oE '[a-zA-Z0-9_-]+\.js' | sort -u); do curl -s https://ourtearoa.duckdns.org/$f; done | grep -oE '"https?://[a-zA-Z0-9.]+/api"' | sort -u
"https://ourtearoa.duckdns.org/api"

$ for f in $(curl -s https://ourtearoa.duckdns.org/ | grep -oE '[a-zA-Z0-9_-]+\.js' | sort -u); do curl -s https://ourtearoa.duckdns.org/$f; done | grep -oE 'http://[a-zA-Z0-9./_-]+' | sort -u | grep -vE 'www.w3.org|localhost' || echo 'none found'
